;==========================================================
;   Minimal i3 status bar — tokyo neon
;==========================================================

[colors]
background = #0d0e1a
background-alt = #1a1b26
foreground = #c0caf5
foreground-muted = #565f89
primary = #ff2ec4
secondary = #2ee6ff
alert = #ff5566

[bar/main]
monitor = ${env:MONITOR:}
width = 100%
height = 24
radius = 0.0
fixed-center = true
top = yes
bottom = no
override-redirect = false

background = ${colors.background}
foreground = ${colors.foreground}

line-size = 0

border-top-size = 0
border-bottom-size = 0
border-left-size = 0
border-right-size = 0

padding-left = 1
padding-right = 1

module-margin-left = 1
module-margin-right = 1

font-0 = "JetBrainsMono Nerd Font:pixelsize=10;2"
font-1 = "JetBrainsMono Nerd Font Mono:pixelsize=11;3"

modules-left = i3
modules-right = updates eth wlan memory pulseaudio battery date tray

wm-restack = i3

scroll-up = #i3.next
scroll-down = #i3.prev

cursor-click = pointer

[module/i3]
type = internal/i3
format = <label-state>
index-sort = true
wrapping-scroll = false
strip-wsnumbers = false
enable-click = true
enable-scroll = false

label-focused = %index%
label-focused-foreground = ${colors.background}
label-focused-background = ${colors.primary}
label-focused-padding = 2

label-unfocused = %index%
label-unfocused-foreground = ${colors.foreground-muted}
label-unfocused-padding = ${self.label-focused-padding}

label-visible = %index%
label-visible-foreground = ${colors.foreground}
label-visible-padding = ${self.label-focused-padding}

label-urgent = %index%
label-urgent-foreground = ${colors.background}
label-urgent-background = ${colors.alert}
label-urgent-padding = 2

[module/updates]
type = custom/script
exec = ~/.config/polybar/scripts/updates.sh
interval = 1800
format = <label>
label = %output%
label-foreground = ${colors.foreground-muted}

[module/eth]
type = internal/network
interface = enp0s31f6
interval = 5
format-connected = <label-connected>
label-connected = ""
label-connected-foreground = ${colors.secondary}
format-disconnected =

[module/wlan]
type = internal/network
interface = wlan0
interval = 5
format-connected = <label-connected>
label-connected = " %essid%"
label-connected-foreground = ${colors.secondary}
format-disconnected =

[module/memory]
type = internal/memory
interval = 3
format = <label>
label = " %percentage_used%% %gb_used%"
label-foreground = ${colors.foreground}

[module/pulseaudio]
type = internal/pulseaudio

format-volume = <label-volume>
label-volume = " %percentage%%"
label-volume-foreground = ${colors.foreground}

format-muted = <label-muted>
label-muted = " muted"
label-muted-foreground = ${colors.foreground-muted}

click-right = pamixer -t

[module/battery]
type = custom/script
exec = ~/.config/polybar/scripts/battery.sh
interval = 30
format = <label>
label = %output%
label-foreground = ${colors.foreground}

[module/date]
type = internal/date
interval = 1

time = %a %d %b  %H:%M

format-prefix-foreground = ${colors.foreground-muted}
label = %time%
label-foreground = ${colors.foreground}

[module/tray]
type = internal/tray
tray-padding = 4
tray-maxsize = 16
tray-background = ${colors.background}

[settings]
screenchange-reload = true
compositing-background = over
compositing-foreground = over
compositing-overline = over
compositing-border = over

[global/wm]
margin-top = 0
margin-bottom = 0
