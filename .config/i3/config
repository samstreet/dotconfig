########################################################################
####
####                   Workplaces layout
####
########################################################################
########################################################################

exec --no-startup-id "i3-msg 'workspace 1; exec alacritty'"

########################################################################
########################################################################
####
####                   Floated windows
####
########################################################################
########################################################################

for_window [title="Calculator"] floating enable
for_window [title="Timer"] floating enable
for_window [class="^.*"] border pixel 1
for_window [class="librewolf"] border none
for_window [class="firefox"] border none
for_window [class="mpv"] floating enable
for_window [class="imv"] floating enable
for_window [class="zenity"] floating enable
for_window [class="cachyos-welcome"] floating enable


########################################################################
########################################################################
####
####                   HOTKEYS
####
########################################################################
########################################################################


bindsym XF86AudioRaiseVolume exec "pamixer -ui 3 && pamixer --get-volume > /tmp/xobpipe"
bindsym XF86AudioLowerVolume exec "pamixer -ud 3 && pamixer --get-volume > /tmp/xobpipe"
# mute sound
bindsym XF86AudioMute exec "amixer sset Master toggle | sed -En '/\[on\]/ s/.*\[([0-9]+)%\].*/\1/ p; /\[off\]/ s/.*/0/p' | head -1 > /tmp/xobpipe"
bindsym XF86AudioMicMute exec "pactl set-source-mute @DEFAULT_SOURCE@ toggle"

# brightness (needs: sudo pacman -S brightnessctl)
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# media playback (needs: sudo pacman -S playerctl)
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# screenshots, omarchy-style (needs: sudo pacman -S flameshot)
bindsym Print exec flameshot gui
bindsym $mod+Print exec flameshot gui
bindsym $mod+Shift+Print exec "flameshot full -c"

bindsym $mod+Shift+p exec gnome-calculator
#bindsym $mod+p exec ~/.scripts/dmshot

## This will switch the current layout to the 'us'.
#bindsym $mod+l exec "setxkbmap -layout us && sleep 0.1 && setxkbmap -option grp:caps_toggle 'us,ru' -option grp_led:caps && sleep 0.1 && i3lock --blur 5"

## This keybind will lock the screen. The lockscreen.
## (omarchy binds lock to super+ctrl+l, keeping super+l too since it's already muscle memory here)
set $lock i3lock --blur 5 --indicator --clock --radius=140 --ring-width=4 --inside-color=1a1b26cc --ring-color=ff2ec4ff --insidever-color=1a1b26cc --ringver-color=2ee6ffff --insidewrong-color=1a1b26cc --ringwrong-color=ff5566ff --line-color=00000000 --keyhl-color=2ee6ffff --bshl-color=ff5566ff --separator-color=00000000 --verif-color=c0caf5ff --wrong-color=ff5566ff --time-color=c0caf5ff --date-color=c0caf5ff --layout-color=c0caf5ff
bindsym $mod+l exec "sleep 0.1 && $lock"
bindsym $mod+Ctrl+l exec "sleep 0.1 && $lock"

########################################################################
########################################################################
####
####                   AUTOLOAD
####
########################################################################
########################################################################

## Here is a language switcher by pressing capslock button,
## and the capslock functionality available by using shift+capslock.
## Uncomment to enable 'us' to/from 'ru' switch. change to language(s) you prefer more.

#exec_always setxkbmap -option grp:caps_toggle "us,ru" -option "grp:caps_toggle,grp_led:caps"

# pin DPI to 96 (1x) so apps that auto-detect DPI from monitor physical size
# (Firefox, Qt/Electron apps) don't render oversized
exec --no-startup-id xrdb -merge ~/.Xresources

# laptop panel: scale >1 renders more logical pixels into the same physical
# panel, shrinking UI elements for more usable desktop space
#
# chained with feh below (rather than a separate exec) because i3 fires
# execs in parallel, not sequentially - feh could otherwise paint the
# wallpaper for the old resolution before xrandr finishes applying the scale
exec --no-startup-id xrandr --output eDP-1 --scale 1.25x1.25 && feh --bg-fill ~/.config/i3/wallpaper.jpg

#exec xrandr --auto --output HDMI-1 --mode 1920x1080 --above HDMI-2

exec --no-startup-id dunst
exec --no-startup-id picom
exec --no-startup-id redshift
exec --no-startup-id dex -a -s /etc/xdg/autostart/:~/.config/autostart/
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# hyprland-style dwindle/spiral tiling: alternates split direction based on
# container dimensions instead of i3's default of always splitting the same way
exec --no-startup-id autotiling

exec_always mkfifo /tmp/xobpipe && tail -f /tmp/xobpipe | xob -t 2170 & disown
